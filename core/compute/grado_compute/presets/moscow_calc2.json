    "school_plot_cap1": {"title": "Школы: верхняя граница первой ступени ёмкости объекта", "unit": "мест", "group": "Участки социальных объектов", "source": "2151-ПП, табл. 1.4.2 (школы), п. 3 «Площадь земельного участка объекта общего образования», п. 3.1 «до 900 мест»", "edition": "02.12.2025", "status": "confirmed", "min": 1, "max": 5000},
    "school_plot_m2_1": {"title": "Школы: участок на место, объект до 900 мест (не менее)", "unit": "м²/место", "group": "Участки социальных объектов", "source": "2151-ПП, табл. 1.4.2 (школы), п. 3 «Площадь земельного участка объекта общего образования», п. 3.1", "edition": "02.12.2025", "status": "confirmed", "min": 1, "max": 200},
    "school_plot_cap2": {"title": "Школы: верхняя граница второй ступени ёмкости объекта", "unit": "мест", "group": "Участки социальных объектов", "source": "2151-ПП, табл. 1.4.2 (школы), п. 3 «Площадь земельного участка объекта общего образования», п. 3.2 «от 901 до 1500 мест»; ровно 1501 место текстом не покрыто — расчёт относит его к «свыше»", "edition": "02.12.2025", "status": "confirmed", "min": 1, "max": 5000},
    "school_plot_m2_2": {"title": "Школы: участок на место, объект от 901 до 1500 мест (не менее)", "unit": "м²/место", "group": "Участки социальных объектов", "source": "2151-ПП, табл. 1.4.2 (школы), п. 3 «Площадь земельного участка объекта общего образования», п. 3.2", "edition": "02.12.2025", "status": "confirmed", "min": 1, "max": 200},
    "school_plot_m2_3": {"title": "Школы: участок на место, объект свыше 1501 места (не менее)", "unit": "м²/место", "group": "Участки социальных объектов", "source": "2151-ПП, табл. 1.4.2 (школы), п. 3 «Площадь земельного участка объекта общего образования», п. 3.3", "edition": "02.12.2025", "status": "confirmed", "min": 1, "max": 200},
    "clinic_plot_norm_ha": {"title": "Поликлиника: участок на один объект (не менее)", "unit": "га на объект", "group": "Участки социальных объектов", "source": "2150-ПП, табл. 1.4.1, п. 2.1 «Поликлиники: детская, взрослая, смешанного типа (без дифференциации) — 0,35 га на 1 объект»", "edition": "28.01.2026", "status": "confirmed", "min": 0.05, "max": 3}
  },
  "metrics": [
    {"id": "calc_area", "title": "Площадь территории проектирования", "unit": "га", "expr": "max(terr_area - restrict_area, 0)", "precision": 3, "group": "Основные показатели"},
    {"id": "spp", "title": "СПП, всего", "unit": "тыс. м²", "expr": "spp_in", "precision": 2, "group": "СПП в ГНС"},
    {"id": "density_spp", "title": "Плотность от СПП", "unit": "тыс. м²/га", "expr": "div(spp, calc_area)", "precision": 2, "group": "Основные показатели"},
    {"id": "spp_res", "title": "СПП жилых зданий", "unit": "тыс. м²", "expr": "spp_low + (spp - spp_low) * ratio_zh / 100", "precision": 2, "group": "СПП в ГНС"},
    {"id": "spp_low", "title": "СПП ИЖС и блокированной застройки", "unit": "тыс. м²", "expr": "min(spp_low_in, spp)", "precision": 2, "group": "СПП в ГНС"},
    {"id": "spp_mkd", "title": "СПП многоквартирных домов", "unit": "тыс. м²", "expr": "spp_res - spp_low", "precision": 2, "group": "СПП в ГНС"},
    {"id": "spp_res_nonres", "title": "СПП нежилой части жилых зданий", "unit": "тыс. м²", "expr": "spp_mkd * nonres_part / 100", "precision": 2, "group": "СПП в ГНС"},
    {"id": "spp_res_living", "title": "СПП жилая", "unit": "тыс. м²", "expr": "spp_mkd - spp_res_nonres", "precision": 2, "group": "СПП в ГНС"},
    {"id": "spp_nonres", "title": "СПП нежилых зданий", "unit": "тыс. м²", "expr": "spp - spp_res", "precision": 2, "group": "СПП в ГНС"},
    {"id": "np", "title": "НП, всего", "unit": "тыс. м²", "expr": "spp * k_np", "precision": 3, "group": "Наземная площадь"},
    {"id": "density_np", "title": "Плотность от НП", "unit": "тыс. м²/га", "expr": "div(np, calc_area)", "precision": 3, "group": "Основные показатели"},
    {"id": "np_res_living", "title": "НП жилая", "unit": "тыс. м²", "expr": "spp_res_living * k_np", "precision": 3, "group": "Наземная площадь"},
    {"id": "np_res_nonres", "title": "НП нежилой части жилых зданий", "unit": "тыс. м²", "expr": "spp_res_nonres * k_np", "precision": 3, "group": "Наземная площадь"},
    {"id": "np_nonres", "title": "НП нежилых зданий", "unit": "тыс. м²", "expr": "spp_nonres * k_np", "precision": 3, "group": "Наземная площадь"},
    {"id": "flats_area", "title": "Площадь квартир МКД", "unit": "тыс. м²", "expr": "spp_res_living * k_flats", "precision": 3, "group": "Единый показатель"},
    {"id": "flats_area_low", "title": "Площадь квартир ИЖС и блокированной застройки", "unit": "тыс. м²", "expr": "spp_low * k_flats", "precision": 3, "group": "Единый показатель"},
    {"id": "flats_area_total", "title": "Общая площадь квартир (с лоджиями и балконами)", "unit": "тыс. м²", "expr": "(flats_area + flats_area_low) * k_flats_total", "precision": 3, "group": "Единый показатель"},
    {"id": "nnp", "title": "Нежилая наземная площадь (ННП)", "unit": "тыс. м²", "expr": "np_res_nonres + np_nonres", "precision": 3, "group": "Единый показатель"},
    {"id": "pop_mkd", "title": "Население МКД", "unit": "чел.", "expr": "ceil(round(flats_area * 1000 / sqm_mkd, 6))", "precision": 0, "group": "Основные показатели", "hidden": true},
    {"id": "pop_low", "title": "Население ИЖС и блокированной застройки", "unit": "чел.", "expr": "ceil(round(flats_area_low * 1000 / sqm_low, 6))", "precision": 0, "group": "Основные показатели", "hidden": true},
    {"id": "population", "title": "Население", "unit": "чел.", "expr": "pop_mkd + pop_low", "precision": 0, "group": "Основные показатели"},
    {"id": "flats", "title": "Количество квартир", "unit": "шт.", "expr": "ceil(round(pop_mkd / per_flat, 6))", "precision": 0, "group": "Основные показатели"},
    {"id": "households", "title": "Количество домовладений и блоков", "unit": "шт.", "expr": "ceil(round(pop_low / per_flat, 6))", "precision": 0, "group": "Основные показатели"},
    {"id": "public_plots", "title": "Участки общественных, производственных объектов", "unit": "га", "expr": "div(calc_area * spp_nonres, spp)", "precision": 3, "group": "Баланс территории"},
    {"id": "res_territory", "title": "Территория жилых зданий", "unit": "га", "expr": "calc_area - public_plots", "precision": 3, "group": "Баланс территории"},
    {"id": "unbuilt", "title": "Незастраиваемая территория", "unit": "га", "expr": "res_territory * unbuilt_share / 100", "precision": 3, "group": "Баланс территории"},
    {"id": "low_plots", "title": "Участки ИЖС и блокированной застройки", "unit": "га", "expr": "min(spp_low / where(tinao == 1, low_density_tinao, low_density_old), max(res_territory - unbuilt, 0))", "precision": 3, "group": "Баланс территории"},
    {"id": "mkd_plots", "title": "Участки многоквартирных домов", "unit": "га", "expr": "max(res_territory - unbuilt - low_plots, 0)", "precision": 3, "group": "Баланс территории"},
    {"id": "density_mkd_plots", "title": "Плотность участков МКД от СПП", "unit": "тыс. м²/га", "expr": "div(spp_mkd, mkd_plots)", "precision": 2, "group": "Баланс территории"},
    {"id": "doo_places", "title": "ДОО", "unit": "мест", "expr": "ceil(round(where(education_zone == 2, doo_z2, doo_z1) * population / 1000, 6))", "precision": 0, "group": "Социальные объекты"},
    {"id": "school_places", "title": "Школы", "unit": "мест", "expr": "ceil(round(where(education_zone == 2, school_z2, school_z1) * population / 1000, 6))", "precision": 0, "group": "Социальные объекты"},
    {"id": "clinic_mixed_visits", "title": "Поликлиника смешанного типа", "unit": "пос./смену", "expr": "ceil(round(clinic_mixed * population / 1000, 6))", "precision": 0, "group": "Социальные объекты"},
    {"id": "clinic_adult_visits", "title": "Поликлиника взрослая", "unit": "пос./смену", "expr": "ceil(round(clinic_adult * population / 1000, 6))", "precision": 0, "group": "Социальные объекты"},
    {"id": "clinic_child_visits", "title": "Поликлиника детская", "unit": "пос./смену", "expr": "ceil(round(clinic_child * population / 1000, 6))", "precision": 0, "group": "Социальные объекты"},
    {"id": "sport_flat_ha", "title": "Плоскостные спортивные сооружения", "unit": "га", "expr": "n_sport_flat * population / 1000 / 10000", "precision": 3, "group": "Обслуживание"},
    {"id": "sport_flat_500_ha", "title": "в т.ч. в радиусе 500 м", "unit": "га", "expr": "n_sport_flat_500 * population / 1000 / 10000", "precision": 3, "group": "Обслуживание"},
    {"id": "sport_flat_1500_ha", "title": "в т.ч. в радиусе 1500 м", "unit": "га", "expr": "n_sport_flat_1500 * population / 1000 / 10000", "precision": 3, "group": "Обслуживание"},
    {"id": "sport_indoor", "title": "Крытые объекты спорта (ННП)", "unit": "тыс. м²", "expr": "n_sport_indoor * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "sport_indoor_500", "title": "в т.ч. в радиусе 500 м", "unit": "тыс. м²", "expr": "n_sport_indoor_500 * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "sport_indoor_1500", "title": "в т.ч. в радиусе 1500 м", "unit": "тыс. м²", "expr": "n_sport_indoor_1500 * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "retail_nnp", "title": "Объекты торговли (ННП)", "unit": "тыс. м²", "expr": "retail * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "services_nnp", "title": "Бытовое обслуживание (ННП)", "unit": "тыс. м²", "expr": "services * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "catering_nnp", "title": "Общественное питание (ННП)", "unit": "тыс. м²", "expr": "catering * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "culture_nnp", "title": "Культура и досуг (ННП)", "unit": "тыс. м²", "expr": "culture * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "city_services_nnp", "title": "Городские службы (ННП)", "unit": "тыс. м²", "expr": "city_services * population / 1000000", "precision": 3, "group": "Обслуживание"},
    {"id": "parking_perm", "title": "Постоянные парковки", "unit": "м/м", "expr": "ceil(round(flats_area * 1000 / (sqm_mkd * per_flat) * parking_d, 6)) + ceil(round(flats_area_low * 1000 / (sqm_low * per_flat) * parking_d, 6))", "precision": 0, "group": "Машино-места"},
    {"id": "parking_guest", "title": "Гостевые парковки", "unit": "м/м", "expr": "ceil(round(parking_perm * guest_share, 6))", "precision": 0, "group": "Машино-места"},
    {"id": "parking_visitor", "title": "Приобъектные парковки", "unit": "м/м", "expr": "ceil(round(np_res_nonres * 1000 / visitor_builtin_m2 * k1 * k2, 6)) + ceil(round(np_nonres * 1000 / visitor_office_m2 * k1 * k2, 6))", "precision": 0, "group": "Машино-места"},
    {"id": "parking_total", "title": "Места хранения и паркирования, всего", "unit": "м/м", "expr": "parking_perm + parking_guest + parking_visitor", "precision": 0, "group": "Машино-места"},
    {"id": "parking_stop", "title": "Места кратковременной остановки", "unit": "м/м", "expr": "ceil(round((flats_area + flats_area_low) * 1000 / stop_flats_m2, 6)) + where(np_res_nonres > 0, min(stop_builtin_max, max(1, ceil(round(np_res_nonres * 1000 / stop_builtin_m2, 6)))), 0)", "precision": 0, "group": "Машино-места"},
    {"id": "green_zhk_ha", "title": "Озеленённые территории ЖК", "unit": "га", "expr": "where(territory_mode == 2, calc_area * green_share_reno, where(territory_mode == 3, calc_area * green_share_mgk, green_zhk_conv * population / 10000))", "precision": 3, "group": "Элементы жилых территорий"},
    {"id": "green_planting_ha", "title": "в т.ч. занятые зелёными насаждениями", "unit": "га", "expr": "where(territory_mode == 1, green_planting_conv * population / 10000, 0)", "precision": 3, "group": "Элементы жилых территорий"},
    {"id": "green_playgrounds_ha", "title": "Площадки детей и взрослых, дорожно-тропиночная сеть", "unit": "га", "expr": "where(territory_mode == 3, green_play_mgk, green_play_other) * population / 10000", "precision": 3, "group": "Элементы жилых территорий"},
    {"id": "green_public_ha", "title": "Озеленённые территории общего пользования", "unit": "га", "expr": "where(territory_mode == 2, 0, green_public_norm * population / 10000)", "precision": 3, "group": "Элементы жилых территорий"},
    {"id": "doo_count", "title": "Число ДОО", "unit": "шт.", "expr": "ceil(div(doo_places, doo_plot_cap2))", "precision": 0, "group": "Участки социальных объектов", "note": "Один объект на весь спрос, пока он укладывается в наибольшую ступень таблицы 1.4.1 (350 мест); больше — равные объекты не более 350 мест. Для отдельно стоящей ДОО свыше 350 мест нормы участка в 2151-ПП нет."},
    {"id": "doo_plot_ha", "title": "Участок ДОО, га (не менее)", "unit": "га", "expr": "doo_places * where(div(doo_places, doo_count) <= doo_plot_cap1, doo_plot_m2_1, doo_plot_m2_2) / 10000", "precision": 3, "group": "Участки социальных объектов", "note": "2151-ПП табл. 1.4.1 п. 3.1-3.2: до 150 мест 35 м²/место, 151-350 мест 32 м²/место, по ёмкости одного объекта; встроенные ДОО (п. 3.3, 20 м²/место) не считаются."},
    {"id": "school_count", "title": "Число школ", "unit": "шт.", "expr": "where(school_places > 0, 1, 0)", "precision": 0, "group": "Участки социальных объектов", "note": "Один объект на весь спрос: верхняя ступень таблицы 1.4.2 (свыше 1501 места) не ограничена сверху, деления нет."},
    {"id": "school_plot_ha", "title": "Участок школы, га (не менее)", "unit": "га", "expr": "school_places * where(school_places <= school_plot_cap1, school_plot_m2_1, where(school_places <= school_plot_cap2, school_plot_m2_2, school_plot_m2_3)) / 10000", "precision": 3, "group": "Участки социальных объектов", "note": "2151-ПП табл. 1.4.2 п. 3.1-3.3: до 900 мест не менее 19, 901-1500 не менее 16, свыше 1501 не менее 14 м²/место. Ровно 1501 место текстом не покрыто — принято как «свыше». Кадетские корпуса, школы без спортивного ядра (п. 3.4-3.5) не считаются."},
    {"id": "clinic_count", "title": "Число поликлиник", "unit": "шт.", "expr": "where(clinic_mixed_visits > 0, 1, 0)", "precision": 0, "group": "Участки социальных объектов", "note": "Норм мощности одной поликлиники (посещений в смену на объект) в 2150-ПП нет, поэтому число объектов принято равным одному — это допущение, не норма."},
    {"id": "clinic_plot_ha", "title": "Участок поликлиники, га (не менее)", "unit": "га", "expr": "clinic_plot_norm_ha * clinic_count", "precision": 3, "group": "Участки социальных объектов", "note": "2150-ПП табл. 1.4.1 п. 2.1: 0,35 га на один объект независимо от мощности; число объектов — допущение (см. «Число поликлиник»)."},
    {"id": "doo_deficit", "title": "Дефицит мест ДОО", "unit": "мест", "expr": "max(doo_places - free_doo, 0)", "precision": 0, "group": "Резерв участков"},
    {"id": "doo_res_n", "title": "Участков ДОО к резерву", "unit": "шт.", "expr": "ceil(div(doo_deficit, doo_plot_cap2))", "precision": 0, "group": "Резерв участков", "note": "Дефицит делится поровну на объекты не более 350 мест, больший объект первым; свободные места вводятся вручную, участок — минимум таблицы 2151-ПП 1.4.1."},
    {"id": "doo_res_q", "title": "Места в меньшем участке ДОО", "unit": "мест", "expr": "floor(div(doo_deficit, doo_res_n))", "precision": 0, "group": "Резерв участков", "hidden": true},
    {"id": "doo_res_r", "title": "Число участков ДОО с q+1 местом", "unit": "шт.", "expr": "doo_deficit - doo_res_q * doo_res_n", "precision": 0, "group": "Резерв участков", "hidden": true},
    {"id": "doo_res_m2", "title": "Участки ДОО, м²", "unit": "м²", "expr": "doo_res_r * (doo_res_q + 1) * where(doo_res_q + 1 <= doo_plot_cap1, doo_plot_m2_1, doo_plot_m2_2) + (doo_res_n - doo_res_r) * doo_res_q * where(doo_res_q <= doo_plot_cap1, doo_plot_m2_1, doo_plot_m2_2)", "precision": 0, "group": "Резерв участков"},
    {"id": "school_deficit", "title": "Дефицит мест школ", "unit": "мест", "expr": "max(school_places - free_school, 0)", "precision": 0, "group": "Резерв участков"},
    {"id": "school_res_m2", "title": "Участок школы, м²", "unit": "м²", "expr": "school_deficit * where(school_deficit <= school_plot_cap1, school_plot_m2_1, where(school_deficit <= school_plot_cap2, school_plot_m2_2, school_plot_m2_3))", "precision": 0, "group": "Резерв участков", "note": "Школа — один участок; ступень площади берётся по дефициту, а не по потребности."},
    {"id": "clinic_deficit", "title": "Дефицит посещений поликлиники", "unit": "пос./смену", "expr": "max(clinic_mixed_visits - free_clinic, 0)", "precision": 0, "group": "Резерв участков"},
    {"id": "clinic_res_m2", "title": "Участок поликлиники, м²", "unit": "м²", "expr": "where(clinic_deficit > 0, clinic_plot_norm_ha * 10000, 0)", "precision": 0, "group": "Резерв участков"},
    {"id": "social_res_m2", "title": "Резерв участков всего, м²", "unit": "м²", "expr": "doo_res_m2 + school_res_m2 + clinic_res_m2", "precision": 0, "group": "Резерв участков"},
    {"id": "social_res_ha", "title": "Резерв участков всего, га", "unit": "га", "expr": "social_res_m2 / 10000", "precision": 3, "group": "Резерв участков"},
    {"id": "social_res_share", "title": "Доля резерва в территории, %", "unit": "%", "expr": "div(social_res_ha, calc_area) * 100", "precision": 3, "group": "Резерв участков"}
  ]
}
