    {"id": "ratio_zh", "title": "Доля жилых зданий в СПП", "unit": "%", "default": 100, "min": 0, "max": 100, "step": 5},
    {"id": "spp_low_in", "title": "СПП ИЖС и блокированной застройки (в составе жилых)", "unit": "тыс. м²", "default": 0, "min": 0, "max": 5000, "step": 0.01},
    {"id": "nonres_part", "title": "Нежилая часть в составе МКД", "unit": "%", "default": 6, "min": 0, "max": 100, "step": 1},
    {"id": "education_zone", "title": "Образовательная зона по 2151-ПП", "unit": "", "default": 1, "min": 1, "max": 2, "step": 1},
    {"id": "k1", "title": "K1 — пешая доступность рельсового каркаса", "unit": "", "default": 1, "min": 0.75, "max": 1, "step": 0.05},
    {"id": "k2", "title": "K2 — деловая активность района", "unit": "", "default": 0.9, "min": 0.2, "max": 0.9, "step": 0.1},
    {"id": "tinao", "title": "ТиНАО (1) или старая Москва (0)", "unit": "", "default": 0, "min": 0, "max": 1, "step": 1},
    {"id": "territory_mode", "title": "Жилые территории по 2152-ПП: 1 — преобразование, 2 — реконструкция, 3 — малоэтажный комплекс", "unit": "", "default": 1, "min": 1, "max": 3, "step": 1},
    {"id": "unbuilt_share", "title": "Незастраиваемая территория в составе жилой", "unit": "%", "default": 25, "min": 0, "max": 90, "step": 1},
    {"id": "free_doo", "title": "Свободные места ДОО в существующих объектах", "unit": "мест", "default": 0, "min": 0, "max": 100000, "step": 1},
    {"id": "free_school", "title": "Свободные места школ в существующих объектах", "unit": "мест", "default": 0, "min": 0, "max": 100000, "step": 1},
