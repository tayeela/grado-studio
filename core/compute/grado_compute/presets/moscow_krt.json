{
  "id": "moscow_krt_tep",
  "title": "ТЭП жилой застройки — Москва (методика КРТ)",
  "sources": [
    "Константы восстановлены из калькулятора genplan.tech/calc (реверс бандла, 2026-07-02)",
    "Соцнормативы: 44 места ДОО и 90 мест школ на 1 тыс. жителей — зона 1 по районам Москвы; поликлиники 13.2 взр. + 5.8 дет. посещений в смену на 1 тыс. жителей",
    "Парковка: 257 м/м на 1 тыс. жителей с коэфф. ж/д доступности и деловой активности (методика на базе 945-ПП)",
    "Перед использованием в проектной документации сверить значения с действующей редакцией МНГП Москвы"
  ],
  "inputs": [
    {"id": "terr_area", "title": "Площадь территории", "unit": "га", "default": 15, "min": 0.1, "max": 500, "step": 0.1},
    {"id": "restrict_area", "title": "Площадь ограничений (не застраивается)", "unit": "га", "default": 0, "min": 0, "max": 500, "step": 0.1},
    {"id": "density", "title": "Плотность застройки по СПП", "unit": "тыс. м²/га", "default": 25, "min": 1, "max": 60, "step": 0.5},
    {"id": "ratio_zh", "title": "Доля жилых зданий в СПП", "unit": "%", "default": 80, "min": 0, "max": 100, "step": 1},
    {"id": "percent_vpp", "title": "Встроенные нежилые помещения (ВПП) в жилых домах", "unit": "%", "default": 6, "min": 0, "max": 30, "step": 1},
    {"id": "k_rail", "title": "Коэфф. ж/д доступности (0.75 — до 1200 м от станции)", "unit": "", "default": 1, "min": 0.5, "max": 1, "step": 0.05},
    {"id": "k_ba", "title": "Коэфф. деловой активности (0.2 — внутри ТТК, 0.5 — вне)", "unit": "", "default": 0.5, "min": 0.1, "max": 1, "step": 0.05}
  ],
  "constants": {
    "coeff_spp_to_np": 0.9,
    "coeff_zh_to_flats": 0.65,
    "sq_flats_per_person": 33,
    "residents_per_flat": 2.1,
    "doo_per_ths": 44,
    "school_per_ths": 90,
    "policlinic_adult_per_ths": 13.2,
    "policlinic_child_per_ths": 5.8,
    "parking_mm_per_ths": 257,
    "min_doo_places": 100,
    "min_school_places": 150,
    "min_policlinic_visits": 320
  },
  "metrics": [
    {"id": "calc_area", "title": "Расчётная площадь территории", "unit": "га", "expr": "terr_area - restrict_area", "precision": 2, "group": "Территория"},
    {"id": "spp", "title": "СПП в габаритах наружных стен", "unit": "тыс. м²", "expr": "density * calc_area", "precision": 1, "group": "Застройка"},
    {"id": "np", "title": "Наземная площадь (НП)", "unit": "тыс. м²", "expr": "spp * coeff_spp_to_np", "precision": 1, "group": "Застройка"},
    {"id": "spp_zh", "title": "СПП жилых зданий", "unit": "тыс. м²", "expr": "spp * ratio_zh / 100", "precision": 1, "group": "Застройка"},
    {"id": "spp_nzh", "title": "СПП нежилых зданий", "unit": "тыс. м²", "expr": "spp - spp_zh", "precision": 1, "group": "Застройка"},
    {"id": "spp_vpp", "title": "СПП встроенных нежилых помещений (ВПП)", "unit": "тыс. м²", "expr": "spp_zh * percent_vpp / 100", "precision": 1, "group": "Застройка"},
    {"id": "spp_zh_net", "title": "СПП жилой части МКД", "unit": "тыс. м²", "expr": "spp_zh - spp_vpp", "precision": 1, "group": "Застройка"},
    {"id": "sq_flats", "title": "Площадь квартир", "unit": "тыс. м²", "expr": "spp_zh_net * coeff_zh_to_flats", "precision": 1, "group": "Жильё и население"},
    {"id": "population_ths", "title": "Население (тыс. чел)", "unit": "тыс. чел", "expr": "sq_flats / sq_flats_per_person", "hidden": true, "group": "Жильё и население"},
    {"id": "population", "title": "Расчётное население", "unit": "чел", "expr": "round(population_ths * 1000)", "precision": 0, "group": "Жильё и население"},
    {"id": "flats", "title": "Количество квартир", "unit": "кв.", "expr": "round(population_ths * 1000 / residents_per_flat)", "precision": 0, "group": "Жильё и население"},
    {"id": "doo_norm", "title": "Потребность в местах ДОО", "unit": "мест", "expr": "round(doo_per_ths * population_ths)", "precision": 0, "group": "Социальные объекты"},
    {"id": "doo_places", "title": "ДОО к размещению (порог 100 мест)", "unit": "мест", "expr": "where(doo_norm >= min_doo_places, doo_norm, 0)", "precision": 0, "group": "Социальные объекты"},
    {"id": "school_norm", "title": "Потребность в местах школ", "unit": "мест", "expr": "round(school_per_ths * population_ths)", "precision": 0, "group": "Социальные объекты"},
    {"id": "school_places", "title": "Школы к размещению (порог 150 мест)", "unit": "мест", "expr": "where(school_norm >= min_school_places, school_norm, 0)", "precision": 0, "group": "Социальные объекты"},
    {"id": "policlinic_norm", "title": "Потребность в поликлиниках", "unit": "посещ./смену", "expr": "round((policlinic_adult_per_ths + policlinic_child_per_ths) * population_ths)", "precision": 0, "group": "Социальные объекты"},
    {"id": "policlinic_places", "title": "Поликлиника к размещению (порог 320 посещ.)", "unit": "посещ./смену", "expr": "where(policlinic_norm >= min_policlinic_visits, policlinic_norm, 0)", "precision": 0, "group": "Социальные объекты"},
    {"id": "parking_perm", "title": "Машино-места постоянного хранения", "unit": "м/м", "expr": "round(population_ths * parking_mm_per_ths * k_rail * k_ba)", "precision": 0, "group": "Транспорт"},
    {"id": "parking_guest", "title": "Гостевые машино-места", "unit": "м/м", "expr": "round(parking_perm / 10)", "precision": 0, "group": "Транспорт"}
  ]
}
